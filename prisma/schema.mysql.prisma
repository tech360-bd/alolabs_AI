model JobQueue {
  id          String   @id @default(cuid())
  name        String   @unique
  description String? @db.LongText
  concurrency Int      @default(3)
  maxRetries  Int      @default(3)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items QueueItem[]
}

model QueueItem {
  id             String    @id @default(cuid())
  queueId        String
  jobId          String? // references AgentRun, SkillRun, WorkflowRun, or generic job
  jobType        String @db.LongText // agent_run, skill_run, workflow_run, email, report, maintenance
  priority       Int       @default(0)
  payload        String @db.LongText    @default("{}")
  status         String    @default("queued") // queued, processing, completed, failed, cancelled
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  error          String? @db.LongText
  result         String? @db.LongText // handler result (payload is preserved for audit)
  idempotencyKey String?   @unique // duplicate-delivery prevention
  lockedBy       String? // worker id holding the processing lease
  lockExpiresAt  DateTime? // lease expiry; expired leases are reclaimed
  heartbeatAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime  @default(now())

  queue JobQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([queueId, status, scheduledAt])
  @@index([status, lockExpiresAt])
}

