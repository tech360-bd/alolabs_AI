generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("viewer") // super_admin, admin, manager, operator, viewer
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  otpSecret    String?
  otpEnabled   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs             AuditLog[]
  approvals             Approval[]
  oauthAccounts         OAuthAccount[]
  commands              Command[]
  managedDepartments    Department[]
  collaborationSessions CollaborationSession[]
  projects              Project[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String? @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions         RolePermission[]
  skillPermissions    SkillPermission[]
  workflowPermissions WorkflowPermission[]
}

model Permission {
  id        String   @id @default(cuid())
  name      String   @unique
  resource  String
  action    String
  createdAt DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Department {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String? @db.LongText
  managerId      String?
  agentCount     Int      @default(20)
  sortOrder      Int      @default(0)
  status         String   @default("active")
  // Tenant that owns this department (null = legacy/unowned row).
  companyId      String?
  // Provisioning profile: budget, allowed models/providers, knowledge sources, KPIs,
  // orchestrator agent business key and the provisioning marker (see src/lib/workforce).
  runtimeProfile String @db.LongText   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company             Company?             @relation(fields: [companyId], references: [id])
  manager             User?                @relation(fields: [managerId], references: [id])
  agents              Agent[]
  departmentMemories  DepartmentMemory[]
  constitutionalRules ConstitutionalRule[]
  enterpriseSOPs      EnterpriseSOP[]
  promptTemplates     PromptTemplate[]
  knowledgeNodes      KnowledgeNode[]
  trainingSources     TrainingSource[]
  aiEmployeeIdentities AIEmployeeIdentity[]
}

model Agent {
  id                String   @id @default(cuid())
  agentId           String   @unique // AGENT-0001 format
  name              String
  slug              String   @unique
  departmentId      String
  departmentName    String
  purpose           String @db.LongText
  type              String   @default("specialist") // conversational, autonomous, workflow, specialized
  role              String   @default("specialist") // manager, planner, execution, qa, report, automation, safety, memory, productivity, owner_approval, specialist
  allowedSkills     String @db.LongText   @default("[]")
  forbiddenSkills   String @db.LongText   @default("[]")
  allowedTools      String @db.LongText   @default("[]")
  forbiddenTools    String @db.LongText   @default("[]")
  inputSchema       String @db.LongText   @default("{}")
  outputSchema      String @db.LongText   @default("{}")
  workflowSteps     String @db.LongText   @default("[]")
  protectionRules   String @db.LongText   @default("[]")
  approvalRules     String @db.LongText   @default("[]")
  handoffRules      String @db.LongText   @default("[]")
  qualityChecklist  String @db.LongText   @default("[]")
  selfImprovement   String @db.LongText   @default("{}")
  productivityRules String @db.LongText   @default("{}")
  status            String   @default("active")
  version           Int      @default(1)
  // Tenant that owns this agent (null = legacy row created before tenant ownership).
  companyId         String?
  // Primary system instructions used by the runtime when this agent executes a task.
  systemInstructions String @db.LongText  @default("")
  // Model configuration, knowledge scope, memory policy, resource limits, task queue,
  // evaluation profile and provisioning marker (see src/lib/workforce).
  runtimeProfile    String @db.LongText   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company                Company?               @relation(fields: [companyId], references: [id])
  department             Department             @relation(fields: [departmentId], references: [id])
  versions               AgentVersion[]
  permissions            AgentPermission[]
  tasks                  Task[]
  memory                 AgentMemory[]
  agentCompanyAccess     AgentCompanyAccess[]
  healthRecords          AgentHealth[]
  statusHistory          AgentStatusHistory[]
  trainingRecords        AgentTrainingRecord[]
  agentRuns              AgentRun[]
  tokenUsage             TokenUsage[]
  evolution              AgentEvolution?
  learningSessions       AgentLearningSession[]
  protectiveMode         AgentProtectiveMode?
  instances              AgentInstance[]
  alerts                 AgentAlert[]
  communicationsSent     AgentCommunication[]   @relation("CommunicationFromAgent")
  communicationsReceived AgentCommunication[]   @relation("CommunicationToAgent")
  trainingSources        TrainingSource[]
  metrics                Metric[]
  recoveryEvents         AgentRecoveryEvent[]
  executions             AgentExecution[]
  evaluations            AgentEvaluation[]
  employeeIdentities     AIEmployeeIdentity[]

  @@index([departmentId])
  @@index([companyId, departmentId])
}

/// Tenant-owned software employee identity, separate from Agent and worker instances.
/// Provisioning creates records in `provisioned` state only; active status requires
/// evidence from a completed, quality-checked, company-scoped execution.
model AIEmployeeIdentity {
  id                         String   @id @default(cuid())
  employeeKey                String
  companyId                  String
  departmentId               String
  agentDbId                  String
  roleKey                    String @db.LongText
  title                      String
  responsibilities           String @db.LongText
  modelPolicy                String @db.LongText
  allowedTools               String @db.LongText   @default("[]")
  permissionProfile          String @db.LongText   @default("{}")
  memoryScope                String @db.LongText   @default("{}")
  resourceLimits             String @db.LongText   @default("{}")
  approvalPolicy             String @db.LongText   @default("{}")
  status                     String   @default("provisioned")
  statusReason               String? @db.LongText
  managedBy                  String? @db.LongText
  planVersion                String? @db.LongText
  configurationHash          String @db.LongText
  supervisorEmployeeKey      String?
  lastVerifiedAt             DateTime?
  lastVerificationExecutionId String? @unique(map: "ai_employee_verification_execution_uniq")
  createdBy                  String? @db.LongText
  updatedBy                  String? @db.LongText
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company             Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department          Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  agent               Agent            @relation(fields: [agentDbId], references: [id], onDelete: Restrict)
  verificationExecution AgentExecution? @relation("AIEmployeeVerification", fields: [lastVerificationExecutionId], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeKey], map: "ai_employee_company_employee_key_uniq")
  @@unique([companyId, agentDbId], map: "ai_employee_company_agent_uniq")
  @@index([companyId, departmentId, status], map: "ai_employee_company_department_status_idx")
  @@index([companyId, status, updatedAt], map: "ai_employee_company_status_updated_idx")
  @@index([supervisorEmployeeKey], map: "ai_employee_supervisor_idx")
}

model AgentVersion {
  id        String   @id @default(cuid())
  agentId   String
  version   Int
  config    String @db.LongText // JSON snapshot
  changeLog String? @db.LongText
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
}

model AgentPermission {
  id          String   @id @default(cuid())
  agentId     String
  resourceId  String
  accessLevel String   @default("read") // read, write, execute, admin
  createdAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Skill {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  category            String
  categorySlug        String
  title               String
  version             String   @default("1.0.0")
  status              String   @default("private") // private, approved, quarantined, disabled
  riskLevel           String @db.LongText   @default("low") // low, medium, high
  requiresApproval    Boolean  @default(true)
  description         String @db.LongText   @default("")
  runtime             String   @default("builtin") // node, python, builtin
  allowedTools        String @db.LongText   @default("[]")
  forbiddenTools      String @db.LongText   @default("[]")
  inputs              String @db.LongText   @default("[]")
  outputs             String @db.LongText   @default("[]")
  purpose             String @db.LongText   @default("")
  validationRules     String @db.LongText   @default("{}")
  securityRules       String @db.LongText   @default("{}")
  costPolicy          String @db.LongText   @default("{}")
  requiredPermissions String @db.LongText   @default("[]")
  safetyRules         String @db.LongText   @default("[]")
  approvalRules       String @db.LongText   @default("")
  failureHandling     String @db.LongText   @default("")
  content             String @db.LongText   @default("") // SKILL.md body
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  versions           SkillVersion[]
  permissions        SkillPermission[]
  validationLogs     SkillValidationLog[]
  skillCompanyAccess SkillCompanyAccess[]
  skillRuns          SkillRun[]
}

model SkillVersion {
  id        String   @id @default(cuid())
  skillId   String
  version   String
  content   String @db.LongText
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
}

model SkillPermission {
  id          String   @id @default(cuid())
  skillId     String
  roleId      String?
  accessLevel String   @default("use")
  createdAt   DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  role  Role? @relation(fields: [roleId], references: [id])

  @@index([skillId])
}

model SkillValidationLog {
  id        String   @id @default(cuid())
  skillId   String
  status    String // PASS, WARNING, BLOCKED
  reason    String? @db.LongText
  checkedBy String? @db.LongText
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Command {
  id           String    @id @default(cuid())
  rawCommand   String @db.LongText
  parsedIntent String? @db.LongText
  detectedDept String? @db.LongText
  workflowId   String?
  status       String    @default("pending") // pending, processing, completed, failed, blocked
  result       String? @db.LongText
  userId       String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  workflow Workflow? @relation(fields: [workflowId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model Task {
  id           String    @id @default(cuid())
  companyId    String?
  commandId    String?
  title        String
  description  String? @db.LongText
  status       String    @default("pending") // pending, in_progress, completed, failed, blocked
  priority     String    @default("medium")
  departmentId String?
  agentId      String?
  workflowId   String?
  userId       String?
  runId        String? // AgentOSRun that created this task (precise run linkage)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  agent          Agent?          @relation(fields: [agentId], references: [id])
  workflow       Workflow?       @relation(fields: [workflowId], references: [id])
  steps          TaskStep[]
  outputs        Output[]
  outputVersions OutputVersion[]
  taskErrors     TaskError[]
  agentRuns      AgentRun[]
  skillRuns      SkillRun[]
  artifacts      Artifact[]

  @@index([companyId, createdAt])
  @@index([agentId])
  @@index([workflowId])
  @@index([runId])
  @@index([status])
}

model TaskStep {
  id          String    @id @default(cuid())
  taskId      String
  stepNumber  Int
  agentId     String?
  skillId     String?
  action      String
  input       String @db.LongText    @default("{}")
  output      String? @db.LongText
  status      String    @default("pending") // pending, in_progress, completed, failed
  error       String? @db.LongText
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Workflow {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String? @db.LongText
  triggers     String @db.LongText   @default("[]")
  stepConfigs  String @db.LongText   @default("[]")
  departmentId String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workflowSteps       WorkflowStep[]
  workflowPermissions WorkflowPermission[]
  commands            Command[]
  runs                WorkflowRun[]
  tasks               Task[]
  improvementRequests WorkflowImprovementRequest[]
}

model WorkflowStep {
  id         String   @id @default(cuid())
  workflowId String
  stepNumber Int
  agentId    String?
  skillId    String?
  action     String
  config     String @db.LongText   @default("{}")
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model Approval {
  id           String    @id @default(cuid())
  type         String // qc_review, agent_build, skill_build, workflow_build, tool_approval, paid_api, external_cost, deployment, dns_change, file_delete, public_publish, bulk_whatsapp, real_human_face, voice_clone, legal_final, financial_final, shell_command, new_agent, new_skill, new_workflow
  title        String
  description  String? @db.LongText
  requestJson  String @db.LongText    @default("{}")
  status       String    @default("pending") // pending, approved, rejected, expired, cancelled
  requestedBy  String?
  reviewedBy   String? @db.LongText
  reviewedAt   DateTime?
  responseNote String? @db.LongText
  riskLevel    String @db.LongText    @default("medium")
  executionId  String?
  companyId    String?
  expiresAt    DateTime? // pending approvals past this instant are expired, never executed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user            User?            @relation(fields: [requestedBy], references: [id])
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRuns       AgentRun[]
  agentExecutions AgentExecution[]

  @@index([companyId, status])
  @@index([executionId])
}

model CapabilityRequest {
  id          String   @id @default(cuid())
  type        String // new_agent, new_skill, new_workflow
  title       String
  description String? @db.LongText
  proposedBy  String? @db.LongText
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentBuildRequest {
  id           String   @id @default(cuid())
  agentName    String @db.LongText
  departmentId String?
  config       String @db.LongText   @default("{}")
  status       String   @default("pending")
  result       String? @db.LongText
  createdAt    DateTime @default(now())
}

model SkillBuildRequest {
  id        String   @id @default(cuid())
  skillName String @db.LongText
  category  String?
  content   String @db.LongText   @default("")
  status    String   @default("pending")
  result    String? @db.LongText
  createdAt DateTime @default(now())
}

model WorkflowBuildRequest {
  id           String   @id @default(cuid())
  workflowName String @db.LongText
  config       String @db.LongText   @default("{}")
  status       String   @default("pending")
  result       String? @db.LongText
  createdAt    DateTime @default(now())
}

model ToolApprovalRequest {
  id        String   @id @default(cuid())
  toolName  String @db.LongText
  reason    String? @db.LongText
  riskLevel String @db.LongText   @default("medium")
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model DomainDeployment {
  id          String   @id @default(cuid())
  domain      String
  projectType String? @db.LongText
  status      String   @default("pending") // pending, deploying, success, failed
  deployLog   String @db.LongText   @default("[]")
  sslStatus   String @db.LongText   @default("none")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectUpload {
  id         String   @id @default(cuid())
  fileName   String @db.LongText
  fileSize   Int      @default(0)
  fileType   String? @db.LongText
  storedPath String? @db.LongText
  uploadedBy String? @db.LongText
  status     String   @default("stored")
  createdAt  DateTime @default(now())
}

model AgentMemory {
  id           String    @id @default(cuid())
  agentId      String
  companyId    String?
  category     String    @default("general") // general, learning, correction, pattern
  content      String @db.LongText
  temperature  String @db.LongText    @default("hot") // hot, warm, cold
  successCount Int       @default(0)
  failCount    Int       @default(0)
  useCount     Int       @default(0)
  confidence   Float     @default(0.5)
  source       String    @default("experience")
  tags         String @db.LongText    @default("[]")
  isVerified   Boolean   @default(false)
  promotedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([companyId, agentId, createdAt])
}

model DepartmentMemory {
  id           String   @id @default(cuid())
  departmentId String
  category     String   @default("general")
  content      String @db.LongText
  temperature  String @db.LongText   @default("warm")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model CompanyMemory {
  id        String   @id @default(cuid())
  companyId String
  category  String   @default("general")
  content   String @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model LearningReport {
  id          String   @id @default(cuid())
  taskId      String?
  agentId     String?
  whatWorked  String @db.LongText   @default("[]")
  whatFailed  String @db.LongText   @default("[]")
  corrections String @db.LongText   @default("[]")
  pattern     String? @db.LongText
  suggestion  String? @db.LongText
  createdAt   DateTime @default(now())
}

model ProductivityReport {
  id                     String   @id @default(cuid())
  taskId                 String?
  speedScore             Float    @default(0)
  qualityScore           Float    @default(0)
  reuseScore             Float    @default(0)
  errorScore             Float    @default(0)
  finalProductivityScore Float    @default(0)
  recommendations        String @db.LongText   @default("[]")
  createdAt              DateTime @default(now())
}

model BlockedAction {
  id         String   @id @default(cuid())
  actionType String @db.LongText
  reason     String @db.LongText
  commandId  String?
  agentId    String?
  createdAt  DateTime @default(now())
}

model PaymentGuardLog {
  id              String   @id @default(cuid())
  apiName         String
  blocked         Boolean  @default(true)
  replacementUsed Boolean  @default(false)
  replacementName String? @db.LongText
  reason          String? @db.LongText
  commandId       String?
  createdAt       DateTime @default(now())

  @@index([apiName])
  @@index([createdAt])
}

model ProtectionLog {
  id         String   @id @default(cuid())
  actionType String @db.LongText
  blocked    Boolean  @default(true)
  reason     String @db.LongText
  commandId  String?
  agentId    String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String @db.LongText   @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Output {
  id        String   @id @default(cuid())
  taskId    String
  type      String   @default("text") // text, file, image, video, audio, report
  content   String @db.LongText
  filePath  String? @db.LongText
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String @db.LongText
  type      String   @default("string") // string, number, boolean, json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HealthCheck {
  id         String   @id @default(cuid())
  service    String @db.LongText
  status     String   @default("healthy") // healthy, degraded, down
  responseMs Int?
  details    String? @db.LongText
  createdAt  DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String @db.LongText
  stack     String? @db.LongText
  severity  String   @default("error")
  createdAt DateTime @default(now())
}

model ServerLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  message   String @db.LongText
  metadata  String @db.LongText   @default("{}")
  createdAt DateTime @default(now())
}

model DeploymentLog {
  id          String   @id @default(cuid())
  domain      String?
  projectType String? @db.LongText
  action      String
  status      String   @default("success")
  details     String @db.LongText   @default("{}")
  createdAt   DateTime @default(now())
}

model SOPUpdate {
  id           String   @id @default(cuid())
  departmentId String?
  title        String
  content      String @db.LongText
  reason       String? @db.LongText
  status       String   @default("suggested") // suggested, approved, applied
  suggestedBy  String? @db.LongText
  approvedBy   String? @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkflowImprovementRequest {
  id          String   @id @default(cuid())
  workflowId  String?
  title       String
  description String? @db.LongText
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model AutomationSuggestion {
  id           String   @id @default(cuid())
  title        String
  description  String? @db.LongText
  departmentId String?
  frequency    String? @db.LongText
  status       String   @default("suggested") // suggested, approved, implemented, rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model File {
  id         String   @id @default(cuid())
  name       String
  path       String @db.LongText
  size       Int      @default(0)
  mimeType   String?
  category   String?
  uploadedBy String? @db.LongText
  createdAt  DateTime @default(now())
}

model Company {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  domain               String?
  status               String   @default("active")
  allowedWorkflows     String @db.LongText   @default("[]")
  allowedDepartments   String @db.LongText   @default("[]")
  monthlyUsageLimit    Int      @default(10000)
  paidApiAllowed       Boolean  @default(false)
  smsAllowed           Boolean  @default(false)
  whatsappBulkAllowed  Boolean  @default(false)
  publicPublishAllowed Boolean  @default(false)
  apiSecret            String? @db.LongText
  webCrmConnected      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                 CompanyUser[]
  apiKeys               CompanyApiKey[]
  usageLogs             UsageLog[]
  permissions           CompanyPermission[]
  subscription          Subscription?
  invoices              Invoice[]
  payments              Payment[]
  tokenBudget           TokenBudget?
  tenantConfig          TenantConfig?
  companyDomains        CompanyDomain[]
  ipAllowlists          CompanyIpAllowlist[]
  agentAccess           AgentCompanyAccess[]
  agents                Agent[]
  departments           Department[]
  knowledgeNodes        KnowledgeNode[]
  agentUsageSummaries   AgentUsageSummary[]
  skillAccess           SkillCompanyAccess[]
  webhooks              WebhookConfig[]
