/// Every generated/repaired output of a task, kept as an immutable version so
/// QC failures and repairs preserve evidence instead of overwriting it.
model OutputVersion {
  id           String   @id @default(cuid())
  taskId       String
  runId        String?
  version      Int
  content      String @db.LongText
  model        String?
  reason       String   @default("initial") // initial, repair, manual
  qcPassed     Boolean?
  qcScore      Float?
  qcIssues     String @db.LongText   @default("[]")
  assessmentId String?
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([runId])
}

/// Configured AI provider (platform-wide when companyId is null). The API key
/// is stored AES-256-GCM encrypted under ENCRYPTION_KEY (src/lib/security/field-encryption.ts); only a fingerprint
/// is ever returned to clients.
model AIProviderConfig {
  id                  String    @id @default(cuid())
  companyId           String?
  provider            String // openai-compatible, anthropic, ollama, openrouter, groq, deepseek, mistral, zai-sdk
  name                String
  baseUrl             String? @db.LongText
  encryptedApiKey     String? @db.LongText
  keyFingerprint      String?
  models              String @db.LongText    @default("[]") // JSON array of { id, capabilities, contextLength, costPerMillionTokens }
  isEnabled           Boolean   @default(true)
  isLocal             Boolean   @default(false) // true only for trusted on-prem/local inference endpoints
  fallbackEligible    Boolean   @default(false)
  priority            Int       @default(100)
  timeoutMs           Int       @default(60000)
  maxRetries          Int       @default(2)
  lastHealthStatus    String? // healthy, degraded, unreachable, unauthorized
  lastHealthAt        DateTime?
  lastHealthLatencyMs Int?
  lastError           String? @db.LongText
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company             Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  verifications       AIProviderVerification[]
  quotaSnapshots      ProviderQuotaSnapshot[]
  companyPermissions  CompanyModelPermission[]
  modelUsageRecords   ModelUsageRecord[]

  @@unique([companyId, name])
  @@index([provider])
  @@index([isEnabled, priority])
}

/// One row per model-router decision (success or failure) for observability,
/// cost tracking and fallback analysis.
model ModelRoutingDecision {
  id               String   @id @default(cuid())
  runId            String?
  taskId           String?
  companyId        String?
  agentId          String?
  requestedModel   String
  taskType         String?
  selectedProvider String?
  selectedModel    String?
  reason           String   @default("")
  candidates       String @db.LongText   @default("[]")
  attempts         Int      @default(1)
  fallbackFrom     String?
  success          Boolean  @default(false)
  errorCode        String?
  errorMessage     String? @db.LongText
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  costUsd          Float?
  createdAt        DateTime @default(now())

  @@index([runId])
  @@index([companyId, createdAt])
  @@index([selectedProvider])
}

