# ============================================================
# ALO Labs AIOS — Environment Variables
# Copy this file to .env and fill in production values.
# cp .env.example .env
# ============================================================

# ── Application ────────────────────────────────────────────────
NODE_ENV=development                # Set to 'production' for production deployments
APP_SECRET=                         # Required. Session encryption secret. Generate: openssl rand -base64 32
JWT_SECRET=                         # Required for AgentOS/session JWTs; use 32+ random bytes (NOT the sandbox value)
STORAGE_SIGNING_SECRET=             # Required to issue signed local-file links; 32+ random bytes
# SEED_ADMIN_EMAIL=admin@alolabs.net # Optional during seed only
# SEED_ADMIN_PASSWORD=              # Required when running seed:agentos; 12+ unique characters; remove after setup
ENCRYPTION_KEY=                     # Required. Data encryption key. Generate: openssl rand -base64 32
CSRF_SECRET=                        # Required. CSRF protection secret. Generate: openssl rand -base64 32
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Public URL of the application (used for OAuth redirects, sitemap)
NEXT_PUBLIC_BASE_URL=http://localhost:3000 # Base URL used for internal API routing (defaults to NEXT_PUBLIC_APP_URL)
ALLOWED_ORIGINS=http://localhost:3000     # Comma-separated allowed CORS origins
SITE_NAME="ALO Labs Agent Hub"       # Display name used in OpenRouter referrer header
SITE_URL=http://localhost:3000       # Site URL used by AI providers for referrer identification
APP_PORT=3000                        # Port the Next.js server listens on

# ── Database (SQLite — default) ───────────────────────────────
DATABASE_URL=file:./db/custom.db    # Dev only. Standalone: use absolute external volume path, e.g. file:/srv/alo-data/custom.db
# PRISMA_SQLITE_ADAPTER=1             # Air-gapped SQLite sandbox only; requires client-engine generation
STORAGE_PATH=./storage               # Legacy storage path
STORAGE_PROVIDER=local               # AgentOS local object storage; S3 adapter not installed
STORAGE_LOCAL_PATH=./uploads         # Private file directory (must be backed up and ACL-protected)

# ── Database (PostgreSQL — optional) ───────────────────────────
# POSTGRES_HOST=localhost            # PostgreSQL host
# POSTGRES_PORT=5432                 # PostgreSQL port
# POSTGRES_USER=alohub               # PostgreSQL username
# POSTGRES_PASSWORD=                 # PostgreSQL password
# POSTGRES_DB=alohub                 # PostgreSQL database name
# POSTGRES_URL=postgresql://alohub:password@localhost:5432/alohub  # Full connection URL (overrides individual settings)
# POSTGRES_SSL=false                 # Enable SSL for PostgreSQL connection
# POSTGRES_POOL_SIZE=10              # Connection pool size
# PG_ALLOW_INSECURE_SSL=false        # Allow insecure SSL (rejectUnauthorized: false) — only for development

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379     # Full Redis connection URL (overrides individual settings)
REDIS_HOST=localhost                 # Redis host
REDIS_PORT=6379                      # Redis port
REDIS_PASSWORD=                      # Redis password (leave empty if no auth)
REDIS_DB=0                           # Redis database index (0-15)
REDIS_PREFIX=alolabs:                # Key prefix for all Redis keys

# ── Qdrant (Vector Database) ───────────────────────────────────
QDRANT_URL=http://localhost:6333    # Full Qdrant URL (overrides individual settings)
QDRANT_HOST=localhost                # Qdrant host
QDRANT_PORT=6333                     # Qdrant port
QDRANT_API_KEY=                      # Qdrant API key (if auth is enabled)
QDRANT_TIMEOUT=10000                 # Request timeout in milliseconds

# ── MinIO / S3 Object Storage ──────────────────────────────────
STORAGE_PROVIDER=local                # Storage backend: local | s3 | minio
MINIO_URL=http://localhost:9000      # Full MinIO URL (overrides individual settings)
MINIO_HOST=localhost                 # MinIO host
MINIO_PORT=9000                      # MinIO port
MINIO_ACCESS_KEY=your_access_key    # MinIO access key
MINIO_SECRET_KEY=your_secret_key    # MinIO secret key
MINIO_BUCKET=agent-hub              # Default MinIO bucket
MINIO_REGION=us-east-1              # MinIO region
MINIO_SSL=false                      # Enable SSL for MinIO connection
MINIO_CDN_URL=                       # Optional CDN URL for public file access

# ── S3 Object Storage (for backups) ────────────────────────────
S3_ENDPOINT=                         # S3-compatible endpoint (e.g., s3.amazonaws.com)
S3_FORCE_PATH_STYLE=false            # Force path-style URLs for DNS endpoints (MinIO behind a domain)
S3_PORT=9000                         # S3 port (defaults to 9000 for MinIO, 443 for AWS)
S3_ACCESS_KEY=                       # S3 access key
S3_SECRET_KEY=                       # S3 secret key
S3_BUCKET=                           # Default S3 bucket
S3_REGION=                           # S3 region
S3_USE_SSL=false                     # Enable SSL for S3 connection
S3_BACKUP_BUCKET=aios-backups        # S3 bucket name for database backups

# ── RAG / Embeddings ───────────────────────────────────────────
EMBEDDING_MODEL=                     # Embedding model name (e.g., text-embedding-3-small)
EMBEDDING_API_URL=                   # Embedding API endpoint URL
EMBEDDING_API_KEY=                   # Embedding API key

# ── AI Model Routing ───────────────────────────────────────────
AI_ROUTE_ENDPOINT=                   # AI routing endpoint URL (defaults to /api/llm/route)
AI_REPLY_MODEL=                      # Default model for AI replies (e.g., deepseek-chat)

# ── AI Provider: ZAI (Primary — uses z-ai-web-dev-sdk) ─────────
# ZAI does not require explicit API key configuration in .env.
# It is used internally via the z-ai-web-dev-sdk package on the backend.

# ── AI Provider: Groq (Fast LPU Inference) ─────────────────────
GROQ_API_KEY=                        # Groq API key — https://console.groq.com
GROQ_BASE_URL=https://api.groq.com/openai/v1  # Groq API base URL
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile     # Default model for general tasks
GROQ_FAST_MODEL=llama-3.1-8b-instant            # Fast model for low-latency tasks
GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b  # Model for reasoning tasks

# ── AI Provider: OpenRouter ────────────────────────────────────
OPENROUTER_API_KEY=                  # OpenRouter API key — https://openrouter.ai/keys

# ── AI Provider: DeepSeek ──────────────────────────────────────
DEEPSEEK_API_KEY=                    # DeepSeek API key — https://platform.deepseek.com

# ── AI Provider: Mistral ───────────────────────────────────────
MISTRAL_API_KEY=                     # Mistral AI API key — https://console.mistral.ai

# ── AI Provider: Qwen ──────────────────────────────────────────
QWEN_API_KEY=                        # Qwen (Alibaba Cloud) API key
QWEN_API_URL=                        # Qwen API base URL (default: DashScope endpoint)

# ── AI Provider: OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=                          # OpenAI API key — https://platform.openai.com/api-keys

# ── Media generation (Media Studio, Image/Music/Video Studio, Avatar & Voice) ──
# Image + speech use any OpenAI-compatible endpoint. Music and video need their
# own job endpoints (e.g. Mureka, Runway, Replicate); {id} is substituted with
# the provider job id when polling. Nothing is generated without a key.
MEDIA_API_KEY=                       # Provider key (falls back to OPENAI_API_KEY)
MEDIA_BASE_URL=                      # Default: https://api.openai.com/v1
MEDIA_PROVIDER=                      # Label stored on jobs (default: openai-compatible)
MEDIA_IMAGE_MODEL=gpt-image-1
MEDIA_AUDIO_MODEL=gpt-4o-mini-tts
MEDIA_VIDEO_ENDPOINT=                # POST target for video jobs
MEDIA_VIDEO_STATUS_ENDPOINT=         # GET target, may contain {id}
MEDIA_VIDEO_MODEL=
MEDIA_MUSIC_ENDPOINT=                # POST target for music jobs
MEDIA_MUSIC_STATUS_ENDPOINT=         # GET target, may contain {id}
MEDIA_MUSIC_MODEL=
MEDIA_TRANSCRIBE_MODEL=whisper-1    # OpenAI-compatible /audio/transcriptions model

# ── AI Provider: Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=                       # Anthropic API key — https://console.anthropic.com

# ── AI Provider: Ollama (Local) ────────────────────────────────
OLLAMA_URL=http://localhost:11434        # Ollama server URL (for Phi, LLaMA, Gemma models)

# ── SMTP / Email ───────────────────────────────────────────────
SMTP_HOST=                           # SMTP server host (e.g., smtp.gmail.com)
SMTP_PORT=587                        # SMTP port (587 for TLS, 465 for SSL)
SMTP_USER=                           # SMTP username
SMTP_PASS=                           # SMTP password
SMTP_FROM=                           # Sender email address (e.g., noreply@alolabs.ai)
EMAIL_TRACKING_SECRET=               # 16+ chars; HMAC key for hosted open-tracking pixel (required for trackOpens)
APP_URL=                             # Public origin used in tracking pixels, e.g. https://app.example.com

# ── SMS ────────────────────────────────────────────────────────
SMS_DEFAULT_FROM=                    # Default SMS sender phone number (e.g., +10000000000)

# ── WhatsApp Business ──────────────────────────────────────────
WHATSAPP_API_URL=                    # Meta Graph API URL (default: https://graph.facebook.com)
WHATSAPP_API_VERSION=                # WhatsApp Business API version (e.g., v21.0)
WHATSAPP_APP_ID=                     # Meta App ID
WHATSAPP_APP_SECRET=                 # Meta App Secret (also used for webhook verification)
WHATSAPP_ACCESS_TOKEN=               # WhatsApp Business access token
WHATSAPP_PHONE_NUMBER_ID=            # WhatsApp phone number ID
WHATSAPP_DEFAULT_COMPANY_ID=        # Fallback tenant for numbers registered before companyId existed
WHATSAPP_VERIFY_TOKEN=               # Webhook verification token
WHATSAPP_REDIRECT_URI=               # OAuth redirect URI for WhatsApp
WHATSAPP_AI_ENABLED=false            # Enable AI-powered auto-replies for WhatsApp
WHATSAPP_AI_ENDPOINT=                # AI endpoint for WhatsApp message processing

# ── Social OAuth (Twitter / X) ─────────────────────────────────
TWITTER_CLIENT_ID=                   # Twitter/X OAuth 2.0 client ID
TWITTER_CLIENT_SECRET=               # Twitter/X OAuth 2.0 client secret
TWITTER_REDIRECT_URI=                # Twitter/X OAuth redirect URI

# ── Social OAuth (LinkedIn) ────────────────────────────────────
LINKEDIN_CLIENT_ID=                  # LinkedIn OAuth 2.0 client ID
LINKEDIN_CLIENT_SECRET=              # LinkedIn OAuth 2.0 client secret
LINKEDIN_REDIRECT_URI=               # LinkedIn OAuth redirect URI

# ── Social OAuth (Facebook) ────────────────────────────────────
FACEBOOK_APP_ID=                     # Facebook App ID
FACEBOOK_APP_SECRET=                 # Facebook App Secret
FACEBOOK_REDIRECT_URI=               # Facebook OAuth redirect URI

# ── Social OAuth (Instagram) ───────────────────────────────────
INSTAGRAM_APP_ID=                    # Instagram App ID
INSTAGRAM_APP_SECRET=                # Instagram App Secret
INSTAGRAM_REDIRECT_URI=              # Instagram OAuth redirect URI

# ── Social OAuth (Google) ──────────────────────────────────────
GOOGLE_CLIENT_ID=                    # Google OAuth 2.0 client ID
GOOGLE_CLIENT_SECRET=                # Google OAuth 2.0 client secret
GOOGLE_REDIRECT_URI=                 # Google OAuth redirect URI

# ── Social OAuth (YouTube) ─────────────────────────────────────
YOUTUBE_CLIENT_ID=                   # YouTube/Google OAuth client ID
YOUTUBE_CLIENT_SECRET=               # YouTube/Google OAuth client secret
YOUTUBE_REDIRECT_URI=                # YouTube OAuth redirect URI

# ── Social OAuth (Telegram) ────────────────────────────────────
TELEGRAM_BOT_ID=                     # Telegram Bot ID
TELEGRAM_BOT_TOKEN=                  # Telegram Bot Token (also used for webhook verification)
TELEGRAM_REDIRECT_URI=               # Telegram OAuth redirect URI

# ── Social OAuth (TikTok) ──────────────────────────────────────
TIKTOK_CLIENT_KEY=                   # TikTok OAuth client key
TIKTOK_CLIENT_SECRET=                # TikTok OAuth client secret
TIKTOK_REDIRECT_URI=                 # TikTok OAuth redirect URI

# ── Social OAuth (Pinterest) ───────────────────────────────────
PINTEREST_APP_ID=                    # Pinterest App ID
PINTEREST_APP_SECRET=                # Pinterest App Secret
PINTEREST_REDIRECT_URI=              # Pinterest OAuth redirect URI

# ── Social Webhook ──────────────────────────────────────────────
SOCIAL_WEBHOOK_VERIFY_TOKEN=         # Fallback webhook verification token for all social platforms

# ── Security ───────────────────────────────────────────────────
AV_SCANNER_ENABLED=false             # Enable ClamAV antivirus scanning for uploads
AV_SCANNER_HOST=localhost            # ClamAV scanner host
AV_SCANNER_PORT=3310                 # ClamAV scanner port

# ── Mini-Services ──────────────────────────────────────────────
REALTIME_PORT=3005                   # Port for the realtime/WebSocket mini-service
CORS_ORIGIN=                         # CORS origin override for mini-services
JWT_SECRET=                          # JWT signing secret for mini-service authentication
SESSION_SECRET=                      # Session secret (alternative to APP_SECRET)

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100                  # Default rate limit (requests per window)
RATE_LIMIT_AI_CHAT=20                   # AI chat rate limit (requests per window)

# ── Caddy ───────────────────────────────────────────────────────
DOMAIN=alolabs.localhost              # Domain for local Caddy development server

# ── Local Inference Gateway (replaces paid model APIs) ──────────
# Any OpenAI-compatible endpoint works: Ollama (/v1), vLLM, LiteLLM, or a
# local proxy. Tier policy → concrete model lives in
# src/lib/ai-router/model-tiers.ts.
LOCAL_INFERENCE_URL=http://localhost:20128/v1   # e.g. http://ollama:11434/v1
# LOCAL_INFERENCE_ENABLED=true                  # implies http://localhost:20128/v1
LOCAL_INFERENCE_API_KEY=                        # only if the local proxy requires one
LOCAL_INFERENCE_PORT=20128
LOCAL_INFERENCE_TIMEOUT_MS=120000
LOCAL_ONLY=true                                 # refuse to route to any paid provider
LOCAL_PROVIDER_NAMES=                           # extra local providers, comma-separated

# Tier 1 — executive / counselling reasoning
LOCAL_MODEL_REASONING=qwen2.5:72b-instruct
# Tier 2 — departmental workflows and CRM automation
LOCAL_MODEL_BALANCED=qwen2.5:32b-instruct
LOCAL_MODEL_CODING=qwen2.5-coder:32b-instruct
LOCAL_MODEL_VISION=qwen2.5vl:7b
# Tier 3 — high-speed classification and tagging
LOCAL_MODEL_FAST=qwen2.5:1.5b-instruct
LOCAL_MODEL_EMBEDDING=embeddinggemma:300m

# ── Supporting services (docker-compose.inference.yml) ──────────
QDRANT_URL=http://localhost:6333
N8N_BASE_URL=http://localhost:5678
MYSQL_DATABASE=alolabs
MYSQL_USER=alolabs
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
N8N_ENCRYPTION_KEY=
