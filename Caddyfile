# Compose gateway. Bare-metal deployments use deploy/caddy/alolabs.net.Caddyfile.
{$DOMAIN:alolabs.localhost} {
	encode zstd gzip
	header {
		-Server
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@api path /api/*
	header @api Cache-Control "no-store"
	# Fixed destinations; only publish these services with the sockets profile.
	handle /queue/socket.io/* {
		reverse_proxy queue-service:3004
	}
	handle /socket.io/* {
		reverse_proxy realtime-service:3005
	}
	handle {
		reverse_proxy {$APP_UPSTREAM:app:3011}
	}
}
